# Server only. Enables the live guide at /api/chat. Never prefix with NEXT_PUBLIC_.
# Set either or both; Groq is tried first, then Gemini. With neither, the guide uses its built-in offline engine.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional. Map tiles; default is CARTO dark (free, attribution shown).
NEXT_PUBLIC_MAP_TILES=
